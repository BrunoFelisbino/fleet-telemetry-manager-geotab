{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Accept"
        },
        {
          "key": "Access-Control-Expose-Headers",
          "value": "Content-Type, ETag"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard.html",
      "destination": "/index.html"
    },
    {
      "source": "/mileage.html",
      "destination": "/mileage/index.html"
    },
    {
      "source": "/incidents.html",
      "destination": "/incidents/index.html"
    },
    {
      "source": "/health.html",
      "destination": "/health/index.html"
    },
    {
      "source": "/exceptions.html",
      "destination": "/exceptions/index.html"
    },
    {
      "source": "/trips.html",
      "destination": "/trips/index.html"
    }
  ]
}
