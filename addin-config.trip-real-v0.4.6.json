    "incidents.html": "<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><title>Ocorrências e SLA</title></head><body><main id=\"app\" style=\"font:14px system-ui;padding:24px;color:#222\"><h2>Ocorrências e SLA</h2><p>Aguardando inicialização do MyGeotab...</p></main><script>(function(){'use strict';window.geotab=window.geotab||{};window.geotab.addin=window.geotab.addin||{};window.geotab.addin.fleetTelemetryManager=function(){return{initialize:function(api,state,cb){document.getElementById('app').innerHTML='<h2>Ocorrências e SLA</h2><p>TESTE OK: Add-In carregado e initialize executado.</p>';console.info('[Fleet TM diagnostico] Ocorrências OK');if(typeof cb==='function')cb();},focus:function(){},blur:function(){}};};})();</script></body></html>",
    "health.html": "<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><title>Fleet Health Score</title></head><body><main id=\"app\" style=\"font:14px system-ui;padding:24px;color:#222\"><h2>Fleet Health Score</h2><p>Aguardando inicialização do MyGeotab...</p></main><script>(function(){'use strict';window.geotab=window.geotab||{};window.geotab.addin=window.geotab.addin||{};window.geotab.addin.fleetTelemetryManager=function(){return{initialize:function(api,state,cb){document.getElementById('app').innerHTML='<h2>Fleet Health Score</h2><p>TESTE OK: Add-In carregado e initialize executado.</p>';console.info('[Fleet TM diagnostico] Health Score OK');if(typeof cb==='function')cb();},focus:function(){},blur:function(){}};};})();</script></body></html>",
    "exceptions.html": "<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><title>Fleet Exception 360</title></head><body><main id=\"app\" style=\"font:14px system-ui;padding:24px;color:#222\"><h2>Fleet Exception 360</h2><p>Aguardando inicialização do MyGeotab...</p></main><script>(function(){'use strict';window.geotab=window.geotab||{};window.geotab.addin=window.geotab.addin||{};window.geotab.addin.fleetTelemetryManager=function(){return{initialize:function(api,state,cb){document.getElementById('app').innerHTML='<h2>Fleet Exception 360</h2><p>TESTE OK: Add-In carregado e initialize executado.</p>';console.info('[Fleet TM diagnostico] Exception 360 OK');if(typeof cb==='function')cb();},focus:function(){},blur:function(){}};};})();</script></body></html>",
    "trips.html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\"/>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n<meta http-equiv=\"Cache-Control\" content=\"no-cache, no-store, must-revalidate\">\n<title>Fleet Trip 360</title>\n<link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\"/>\n<style data-bundle=\"reports/premium.css\" media=\"print\">\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Montserrat:wght@400;500;600;700;800;900&family=Roboto:wght@400;500;600;700;800;900&display=swap');\n@page { size: A4; margin: 0; }\n@media print {\n  html,body { margin:0 !important; padding:0 !important; background:#fff !important; background-image:none !important; min-height:0 !important; }\n  body,#app { min-height:0 !important; padding:0 !important; background:#fff !important; background-image:none !important; overflow:hidden !important; }\n  #app,.bar,.head,.info,.panel,.grid,.cols,.tablewrap,.alert { display:none !important; visibility:hidden !important; }\n  .pdf-stage,#pdfStage { display:block !important; visibility:visible !important; position:static !important; left:auto !important; top:auto !important; width:auto !important; max-width:none !important; overflow:visible !important; }\n  .pdf-page { width:210mm !important; height:297mm !important; min-height:297mm !important; max-height:297mm !important; padding:56px 54px !important; margin:0 !important; overflow:hidden !important; page-break-after:always !important; break-after:page !important; page-break-inside:avoid !important; position:relative !important; box-shadow:none !important; }\n  .pdf-cover-page { overflow:hidden !important; }\n  .pdf-ranking-page { height:auto !important; max-height:none !important; overflow:visible !important; }\n  .pdf-ranking-page table { page-break-inside:auto !important; }\n  .pdf-page:last-child { page-break-after:auto !important; break-after:auto !important; }\n  .pdf-table {\n    page-break-inside: auto;\n  }\n  .pdf-table thead {\n    display: table-header-group; /* Força a repetição em cada página */\n  }\n  .pdf-table tr {\n    page-break-inside: avoid; /* Evita que uma linha seja cortada ao meio */\n    page-break-after: auto;\n  }\n  .pdf-ranking-page {\n    height: auto !important;\n    min-height: 297mm;\n    overflow: visible !important;\n    display: block !important;\n  }\n  /* Reduz o tamanho da fonte e o padding da tabela para caber mais veículos por página */\n  .pdf-table th, .pdf-table td {\n    font-size: 8.5px !important; /* Fonte menor para aumentar densidade */\n    padding: 3px 2px !important;  /* Espaçamento vertical reduzido */\n  }\n  .pdf-table .pdf-badge {\n    font-size: 7.5px !important; /* Ajuste proporcional para os badges de status */\n  }\n  /* Destaque para veículos com score muito baixo (Risco Alto) */\n  .pdf-row-risk {\n    background-color: rgba(239, 68, 68, 0.07) !important;\n    -webkit-print-color-adjust: exact;\n  }\n  /* Remove a coluna de Status para ganhar espaço horizontal */\n  .c-status {\n    display: none !important;\n  }\n  /* Estilo da Legenda */\n  .pdf-legend {\n    display: flex;\n    align-items: center;\n    gap: 15px;\n  }\n  .pdf-legend-item i {\n    display: inline-block;\n    width: 10px; height: 10px;\n    border-radius: 2px;\n  }\n  .pdf-legend-item i.risk { background: rgba(239, 68, 68, 0.2); border: 1px solid #ef4444; }\n}\n*{box-sizing:border-box}\n:root{--bg:#f5f8fc;--card:#fff;--txt:#172033;--mut:#64748b;--bd:#e5eaf1;--blue:#0ea5e9;--blue2:#0369a1;--green:#10b981;--yellow:#f59e0b;--orange:#f97316;--red:#ef4444;--shadow:0 12px 28px rgba(15,23,42,.06);--mono:Consolas,monospace}\nhtml,body{margin:0;padding:0}\nbody,#app{font-family:var(--fleet-brand-font,system-ui,Arial,sans-serif);background:var(--bg);min-height:100vh;color:var(--txt);padding:16px 20px;background-image:radial-gradient(circle,rgba(15,23,42,.045) 1px,transparent 1px);background-size:24px 24px}\n.head,.bar,.info,.panel,.kpi,.pdf-card,.pdf-kpi,.pdf-action,.pcp-exec-card{background:var(--card);border:1px solid var(--bd);border-radius:16px;box-shadow:var(--shadow)}\n.head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;margin-bottom:12px}.brand{display:flex;gap:14px;align-items:center}.logo,.pdf-logo,.pcp-logo{object-fit:contain;object-position:left center}.logo{height:46px;width:168px;background:#000;border-radius:10px;padding:4px 8px}.title{font-weight:900;font-size:18px;line-height:1.1}.sub{font-family:var(--mono);font-size:10px;color:var(--mut);font-weight:400;margin-top:4px}.pill{font-family:var(--mono);font-size:10px;color:var(--blue2);background:#fff;border:1px solid var(--bd);border-radius:99px;padding:5px 12px}.bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:12px;margin-bottom:12px}.info{display:flex;gap:16px;flex-wrap:wrap;padding:9px 14px;margin-bottom:12px;color:var(--mut);font-size:12px}button,select,input{height:32px;border-radius:8px;border:1px solid var(--bd);background:#fff;color:var(--txt);font-size:11px;padding:0 10px}input{min-width:190px}button{font-weight:800;cursor:pointer}.primary{background:linear-gradient(135deg,var(--blue),var(--blue2));color:#fff;border:0}.soft{background:#f0f9ff;color:var(--blue2)}.alert{padding:10px 14px;border-radius:10px;margin-bottom:12px;font-size:12px;background:rgba(14,165,233,.1);border:1px solid rgba(14,165,233,.22);color:var(--blue2)}.alert.ok{background:rgba(16,185,129,.12);border-color:rgba(16,185,129,.22);color:#047857}.alert.err{background:rgba(239,68,68,.1);border-color:rgba(239,68,68,.22);color:#b91c1c}.grid,.cols{display:grid;gap:12px}.grid{grid-template-columns:repeat(5,minmax(0,1fr));margin-bottom:12px}.cols{grid-template-columns:1fr 1fr;margin-bottom:12px}.kpi{padding:14px 16px}.kpi span,.pdf-kpi small,.pdf-section-title,.pdf-brand,.pcp-chip-label,.pcp-tagline{font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--mut)}.kpi b{display:block;font-size:26px;line-height:1.1;margin:10px 0 6px}.kpi small{color:var(--mut);font-size:11px}.pt,.pdf-title,.pcp-title{font-weight:900}.pt,.pdf-section-title{padding:14px 16px;border-bottom:1px solid var(--bd);margin:0}.panel{overflow:hidden}.barrow,.row{display:grid;grid-template-columns:1fr 1fr 40px;gap:8px;align-items:center;padding:10px 16px;border-bottom:1px solid #eef2f7}.track{height:8px;background:#eef2f7;border-radius:999px;overflow:hidden}.fill{height:100%;border-radius:inherit}.exec{padding:14px 16px;font-size:12px;color:var(--mut);line-height:1.5}.exec div+div{margin-top:10px}.tablewrap{overflow:auto}.tablewrap table,.pdf-table{width:100%;border-collapse:collapse}.tablewrap th,.tablewrap td,.pdf-table th,.pdf-table td{padding:10px 8px;border-bottom:1px solid #eef2f7;text-align:left;font-size:11px}.badge,.pdf-badge{display:inline-flex;align-items:center;padding:4px 8px;border-radius:999px;font-size:10px;font-weight:800}.okb,.pdf-ok{background:rgba(16,185,129,.12);color:#047857}.warnb,.pdf-warn{background:rgba(245,158,11,.12);color:#b45309}.orangeb,.pdf-critical{background:rgba(249,115,22,.12);color:#c2410c}.riskb,.pdf-risk{background:rgba(239,68,68,.12);color:#b91c1c}.pdf-stage{position:absolute;left:-10000px;top:0;width:210mm}.pdf-page{width:210mm;min-height:297mm;background:#fff;color:#172033;position:relative;page-break-after:always;padding:56px 54px}.pdf-topbar{height:6px;background:linear-gradient(90deg,var(--blue),var(--blue2));border-radius:999px;margin-bottom:18px}.pdf-brand{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:18px}.pdf-title{font-size:26px;line-height:1;margin:0;color:var(--txt)}.pdf-subtitle{font-size:11px;color:var(--mut);margin-top:6px}.pdf-logo{height:42px;max-width:150px}.pdf-grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}.pdf-kpi{padding:14px 16px}.pdf-kpi b{display:block;font-size:28px;margin:10px 0 4px}.pdf-kpi span,.pdf-summary-box{font-size:11px;color:var(--mut)}.pdf-section{margin-top:10px}.pdf-two-col{display:grid;grid-template-columns:1.1fr .9fr;gap:12px}.pdf-card,.pdf-action{padding:14px 16px}.pdf-bars .row{grid-template-columns:140px 1fr 26px;padding-left:0;padding-right:0}.pdf-summary-box{padding:10px 12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px}.pdf-summary-box+.pdf-summary-box{margin-top:8px}.pdf-action h4{margin:0 0 8px;font-size:13px}.pdf-action p{margin:0;color:var(--mut);font-size:11px;line-height:1.5}.pdf-footer{position:absolute;left:54px;right:54px;bottom:24px;display:flex;justify-content:space-between;font-size:10px;color:var(--mut);border-top:1px solid #e2e8f0;padding-top:10px}.pdf-cover-page{background:linear-gradient(145deg,#050d1f 0%,#0a1535 45%,#071228 100%);color:#fff;overflow:hidden;position:relative}.pcp-dots{position:absolute;inset:0;background-image:radial-gradient(circle,rgba(77,184,255,.18) 1px,transparent 1px);background-size:22px 22px;pointer-events:none}.pdf-cover-page::before{content:'';position:absolute;top:-120px;right:-80px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(3,105,161,.55) 0%,transparent 70%);pointer-events:none}.pcp-header,.pcp-hero,.pcp-chips,.pcp-exec-card{position:relative;z-index:2}.pcp-header{margin-bottom:32px}.pcp-logo{background:#000;border-radius:16px;padding:0;height:70px;width:auto;display:block}.pcp-hero{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:28px}.pcp-title-block{display:flex;gap:14px;align-items:flex-start}.pcp-bar{width:5px;min-height:130px;background:linear-gradient(#4db8ff,#0369a1);border-radius:4px;flex-shrink:0;margin-top:6px}.pcp-title{font-size:52px;line-height:1;margin:0 0 10px 0;color:#fff;letter-spacing:-.01em}.pcp-tagline{color:#93c5fd}.pcp-truck-silhouette{width:260px;flex-shrink:0;margin-top:8px}.pcp-chips{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px}.pcp-chip{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:10px 14px;display:flex;gap:10px;align-items:center;min-width:155px}.pcp-chip-icon{font-size:18px;opacity:.85}.pcp-chip-label{color:#93c5fd;font-weight:700}.pcp-chip-val{font-size:13px;font-weight:900;color:#fff;margin-top:2px}.pcp-exec-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:22px;padding:22px 24px;display:flex;gap:24px;align-items:center}.pcp-exec-text{flex:1}.pcp-exec-header{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:900;color:#fff;margin-bottom:10px}.pcp-shield{font-size:20px}.pcp-exec-rule{height:2px;background:linear-gradient(90deg,#0ea5e9,transparent);border-radius:2px;margin-bottom:12px}.pcp-exec-text p{margin:0 0 8px 0;font-size:11.5px;color:#bfdbfe;line-height:1.55}.pcp-kpi-row{display:flex;gap:20px;margin-top:16px;padding-top:14px;border-top:1px solid rgba(255,255,255,.1)}.pcp-kpi-item{display:flex;flex-direction:column;align-items:center;gap:2px;text-align:center}.pcp-kpi-item b{font-size:22px;font-weight:900;color:#fff;line-height:1}.pcp-kpi-item small{font-size:9px;color:#93c5fd;line-height:1.35;margin-top:2px}.pcp-kpi-item .pcp-kpi-icon{font-size:16px;margin-bottom:2px}.pcp-kpi-item.warn b{color:#fbbf24}.pcp-kpi-item.red b{color:#f87171}.pcp-kpi-item.green b{color:#34d399}.pcp-index-wrap{flex-shrink:0}.pcp-ring-outer{width:168px;height:168px;border-radius:50%;display:flex;align-items:center;justify-content:center;padding:12px}.pcp-ring-inner{width:144px;height:144px;border-radius:50%;background:#0a1535;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px}.pcp-ring-inner b{font-size:52px;font-weight:900;line-height:1}.pcp-ring-inner span{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#93c5fd}.pcp-pulse{font-size:16px;color:#38bdf8;margin-top:4px;opacity:.7}.pdf-table .c-num{width:28px}.pdf-table .c-score{width:48px}.pdf-table .c-plate{width:90px}.pdf-table .c-last{width:52px}.pdf-table .c-status{width:80px}.tablewrap table{min-width:1080px;table-layout:fixed}.tablewrap th,.tablewrap td{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.tablewrap th:nth-child(1),.tablewrap td:nth-child(1){width:44px}.tablewrap th:nth-child(2),.tablewrap td:nth-child(2){width:70px}.tablewrap th:nth-child(3),.tablewrap td:nth-child(3){width:120px}.tablewrap th:nth-child(4),.tablewrap td:nth-child(4){width:280px}.tablewrap th:nth-child(5),.tablewrap td:nth-child(5){width:92px}.tablewrap th:nth-child(6),.tablewrap td:nth-child(6){width:210px}.tablewrap th:nth-child(7),.tablewrap td:nth-child(7){width:220px}.tablewrap th:nth-child(8),.tablewrap td:nth-child(8){width:110px}\n\n/* A marca, os ícones e a fonte são selecionados após conectar ao MyGeotab. */\n@media screen,print {\n  #pdfStage, #pdfStage .pdf-page, #pdfStage .pdf-page * {\n    font-family:var(--fleet-brand-font,system-ui,Arial,sans-serif) !important;\n  }\n  #pdfStage .pcp-title,#pdfStage .pdf-title {font-weight:800 !important;letter-spacing:-.02em;line-height:1.07}\n  #pdfStage .pdf-section-title,#pdfStage .pcp-exec-header {font-weight:700 !important}\n  #pdfStage .pdf-logo,#pdfStage .pcp-logo {background:transparent !important;object-fit:contain !important}\n  #pdfStage .pdf-brand-qr {break-inside:avoid}\n}\n\n/* Índice/capa do PDF e logo opcional de impressão. */\n.pcp-toc{margin:0 0 20px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:12px 16px}\n.pcp-toc-head{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#93c5fd;font-weight:800;margin-bottom:8px}\n.pcp-toc-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}\n.pcp-toc-item{display:flex;align-items:center;gap:8px;color:#e2e8f0;font-size:11px}\n.pcp-toc-item b{font-family:var(--mono);color:#38bdf8;font-size:11px}\n.pcp-toc-item span{flex:1}\n.pcp-toc-item em{font-style:normal;color:#94a3b8;font-size:10px;white-space:nowrap}\n.pcp-index-wrap{text-align:center}\n.pcp-index-band{margin-top:8px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.05em}\n.pcp-scale{display:flex;height:6px;border-radius:99px;overflow:hidden;margin-top:6px}\n.pcp-scale i{flex:1}\n.pcp-scale .r{background:#ef4444}.pcp-scale .o{background:#f97316}.pcp-scale .y{background:#f59e0b}.pcp-scale .g{background:#10b981}\n.pcp-scale-labels{display:flex;justify-content:space-between;color:#94a3b8;font-size:8px;font-family:var(--mono);margin-top:3px}\n.pdf-footer-logo{display:inline-block}\n\n</style>\n\n<script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>\n<style>html,body{margin:0;padding:0;background:#f5f8fc;color:#172033;font-family:'Segoe UI',system-ui,sans-serif} .map{height:420px;border-radius:12px;border:1px solid #e5eaf1}</style>\n</head>\n<body>\n<div id=\"app\"><div style=\"padding:40px;color:#64748b;font-size:13px\">Carregando Fleet Trip 360...</div></div>\n\n<script>\nconsole.info('[Fleet Trip 360 v0.4.6] script real carregado');\n/* Fleet Health Score - opções de impressão do PDF (logo opcional, sem persistência). */\n(function () {\n  'use strict';\n\n  var MAX_BYTES = 512 * 1024;\n\n  function esc(value) {\n    return String(value == null ? '' : value)\n      .replace(/&/g, '&amp;')\n      .replace(/</g, '&lt;')\n      .replace(/>/g, '&gt;')\n      .replace(/\"/g, '&quot;');\n  }\n\n  function injectStyle() {\n    if (document.getElementById('printOptionsStyle')) return;\n    var style = document.createElement('style');\n    style.id = 'printOptionsStyle';\n    style.textContent =\n      '.po-overlay{position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(6,12,24,.68);backdrop-filter:blur(4px)}' +\n      '.po-card{width:100%;max-width:520px;max-height:92vh;overflow:auto;background:#fff;color:#0f172a;border-radius:18px;padding:22px;box-shadow:0 24px 80px rgba(2,6,23,.45);font:14px/1.45 \"Segoe UI\",system-ui,Arial,sans-serif}' +\n      '.po-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:8px}' +\n      '.po-head h2{margin:0;font-size:19px;letter-spacing:-.01em}' +\n      '.po-sub{margin:4px 0 0;color:#64748b;font-size:12px}' +\n      '.po-x{width:32px;height:32px;border:1px solid #e2e8f0;background:#f8fafc;border-radius:9px;font-size:20px;line-height:1;cursor:pointer;color:#475569}' +\n      '.po-check{display:flex;align-items:center;gap:9px;margin:16px 0;padding:11px 12px;border:1px solid #dbe3ec;border-radius:11px;background:#f8fbff;font-weight:800;cursor:pointer}' +\n      '.po-check input{width:17px;height:17px;margin:0;accent-color:#0ea5e9}' +\n      '.po-drop{border:1px dashed #cbd5e1;border-radius:12px;padding:14px;background:#fbfdff}' +\n      '.po-file-label{display:block;font-weight:800;font-size:12px;margin-bottom:7px}' +\n      '.po-drop input[type=file]{width:100%;font-size:12px}' +\n      '.po-hint{color:#64748b;font-size:11px;margin-top:7px;line-height:1.5}' +\n      '.po-preview{display:flex;align-items:center;justify-content:center;min-height:76px;margin-top:11px;padding:8px;border-radius:9px;background:#eef2f7;border:1px solid #dbe3ec;color:#94a3b8;font-size:12px}' +\n      '.po-preview img{max-width:220px;max-height:64px;object-fit:contain}' +\n      '.po-msg{min-height:18px;margin:10px 0 0;font-size:12px;color:#b91c1c}' +\n      '.po-actions{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap;margin-top:10px}' +\n      '.po-actions button{height:36px;padding:0 16px;border-radius:9px;border:1px solid #cbd5e1;background:#fff;color:#0f172a;font-weight:800;font-size:12px;cursor:pointer}' +\n      '.po-actions .po-ok{background:linear-gradient(135deg,#0ea5e9,#0369a1);border:0;color:#fff}';\n    document.head.appendChild(style);\n  }\n\n  function safeSvg(text) {\n    var bad = /<script|onload\\s*=|onerror\\s*=|onclick\\s*=|javascript:|<foreignObject|<iframe|<!ENTITY|xlink:href\\s*=\\s*[\"']\\s*(?:https?:|\\/\\/)/i;\n    return !bad.test(String(text || ''));\n  }\n\n  function isSvg(file, name) {\n    return /svg/i.test(file.type || '') || /\\.svg$/i.test(name);\n  }\n\n  function isRaster(file, name) {\n    return /^image\\/(png|jpeg|webp)$/i.test(file.type || '') || /\\.(png|jpe?g|webp)$/i.test(name);\n  }\n\n  function fileToDataUrl(file) {\n    return new Promise(function (resolve, reject) {\n      if (!file) return resolve('');\n      var name = file.name || '';\n      if (file.size > MAX_BYTES) return reject(new Error('O logo deve ter no máximo 512 KB.'));\n      if (isSvg(file, name)) {\n        return file.text().then(function (text) {\n          if (!safeSvg(text)) return reject(new Error('O SVG contém conteúdo não permitido. Use um SVG simples, sem scripts.'));\n          resolve('data:image/svg+xml;charset=utf-8,' + encodeURIComponent(text));\n        }).catch(function () {\n          reject(new Error('Não foi possível ler o SVG.'));\n        });\n      }\n      if (!isRaster(file, name)) return reject(new Error('Envie um arquivo SVG, PNG, JPG ou WebP.'));\n      var reader = new FileReader();\n      reader.onerror = function () { reject(new Error('Não foi possível ler o arquivo.')); };\n      reader.onload = function () { resolve(String(reader.result || '')); };\n      reader.readAsDataURL(file);\n    });\n  }\n\n  function ask(options) {\n    options = options || {};\n    if (!document || !document.body) return Promise.resolve({ includeLogo: false, logo: '' });\n    injectStyle();\n    return new Promise(function (resolve) {\n      var overlay = document.createElement('div');\n      overlay.className = 'po-overlay';\n      overlay.innerHTML =\n        '<section class=\"po-card\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"poTitle\">' +\n          '<div class=\"po-head\"><div><h2 id=\"poTitle\">' + esc(options.title || 'Imprimir PDF') + '</h2>' +\n            '<p class=\"po-sub\">' + esc(options.subtitle || 'Escolha se o relatório deve levar um logo.') + '</p></div>' +\n            '<button type=\"button\" class=\"po-x\" aria-label=\"Fechar\">&times;</button></div>' +\n          '<label class=\"po-check\"><input type=\"checkbox\" data-po=\"include\"/> Incluir logo no PDF</label>' +\n          '<div class=\"po-drop\">' +\n            '<label class=\"po-file-label\" for=\"poFile\">Logo do relatório (SVG, PNG, JPG ou WebP)</label>' +\n            '<input id=\"poFile\" type=\"file\" accept=\".svg,image/svg+xml,image/png,image/jpeg,image/webp\"/>' +\n            '<div class=\"po-hint\">O logo é aplicado no cabeçalho, na capa/índice e nos rodapés deste PDF. Ele não é salvo na base.</div>' +\n            '<div class=\"po-preview\" data-po=\"preview\"><span>Nenhum logo selecionado</span></div>' +\n          '</div>' +\n          '<p class=\"po-msg\" data-po=\"msg\" role=\"status\"></p>' +\n          '<div class=\"po-actions\"><button type=\"button\" data-po=\"cancel\">Cancelar</button>' +\n            '<button type=\"button\" class=\"po-ok\" data-po=\"ok\">Gerar PDF</button></div>' +\n        '</section>';\n      document.body.appendChild(overlay);\n\n      var include = overlay.querySelector('[data-po=\"include\"]');\n      var fileInput = overlay.querySelector('#poFile');\n      var preview = overlay.querySelector('[data-po=\"preview\"]');\n      var msg = overlay.querySelector('[data-po=\"msg\"]');\n      var okBtn = overlay.querySelector('[data-po=\"ok\"]');\n      var cancelBtn = overlay.querySelector('[data-po=\"cancel\"]');\n      var closeBtn = overlay.querySelector('.po-x');\n      var dataUrl = '';\n      var busy = false;\n\n      function finish(result) {\n        document.removeEventListener('keydown', onKey);\n        overlay.remove();\n        resolve(result);\n      }\n      function cancel() { finish(null); }\n      function onKey(event) { if (event.key === 'Escape') cancel(); }\n\n      function showPreview(src, label) {\n        if (src) {\n          preview.innerHTML = '';\n          var img = document.createElement('img');\n          img.src = src;\n          img.alt = 'Prévia do logo';\n          preview.appendChild(img);\n        } else {\n          preview.innerHTML = '<span>' + esc(label || 'Nenhum logo selecionado') + '</span>';\n        }\n      }\n\n      fileInput.addEventListener('change', function () {\n        var file = fileInput.files && fileInput.files[0];\n        msg.textContent = '';\n        if (!file) {\n          dataUrl = '';\n          showPreview('');\n          return;\n        }\n        busy = true;\n        okBtn.disabled = true;\n        msg.style.color = '#64748b';\n        msg.textContent = 'Preparando logo...';\n        fileToDataUrl(file).then(function (url) {\n          dataUrl = url;\n          include.checked = true;\n          showPreview(url, file.name);\n          msg.textContent = '';\n        }).catch(function (error) {\n          dataUrl = '';\n          include.checked = false;\n          showPreview('');\n          msg.style.color = '#b91c1c';\n          msg.textContent = error && error.message ? error.message : 'Não foi possível usar este logo.';\n        }).finally(function () {\n          busy = false;\n          okBtn.disabled = false;\n          msg.style.color = msg.textContent ? '#b91c1c' : '';\n        });\n      });\n\n      include.addEventListener('change', function () {\n        if (include.checked && !dataUrl) {\n          msg.style.color = '#64748b';\n          msg.textContent = 'Selecione o arquivo do logo para incluí-lo no PDF.';\n        } else {\n          msg.textContent = '';\n        }\n      });\n\n      okBtn.addEventListener('click', function () {\n        if (busy) return;\n        if (include.checked && !dataUrl) {\n          msg.style.color = '#b91c1c';\n          msg.textContent = 'Selecione o logo ou desmarque a opção para gerar o PDF sem logo.';\n          return;\n        }\n        finish({ includeLogo: !!include.checked, logo: include.checked ? dataUrl : '' });\n      });\n\n      cancelBtn.addEventListener('click', cancel);\n      closeBtn.addEventListener('click', cancel);\n      overlay.addEventListener('click', function (event) { if (event.target === overlay) cancel(); });\n      document.addEventListener('keydown', onKey);\n      setTimeout(function () { include.focus(); }, 30);\n    });\n  }\n\n  function decorate(stage, logo) {\n    if (!stage || !logo) return;\n    function img(className) {\n      var el = document.createElement('img');\n      el.className = className || 'pdf-footer-logo';\n      el.src = logo;\n      el.alt = 'Logo do relatório';\n      el.style.cssText = 'height:18px;max-width:110px;object-fit:contain;vertical-align:middle;opacity:.92';\n      return el;\n    }\n    stage.querySelectorAll('.pdf-footer').forEach(function (footer) {\n      if (footer.querySelector('.pdf-footer-logo')) return;\n      var el = img('pdf-footer-logo');\n      el.style.marginRight = '8px';\n      footer.insertBefore(el, footer.firstChild);\n    });\n    stage.querySelectorAll('.pdf-brand, .pcp-header').forEach(function (head) {\n      if (head.querySelector('img')) return;\n      var el = img('pdf-logo');\n      el.style.height = head.classList.contains('pcp-header') ? '64px' : '42px';\n      el.style.maxWidth = '180px';\n      head.appendChild(el);\n    });\n  }\n\n  window.PrintOptions = { ask: ask, decorate: decorate, fileToDataUrl: fileToDataUrl };\n})();\n;\n(function(){\n\n'use strict';\nconst DAY_MS=86400000;\nlet apiRef=null,map=null,layer=null,vehicles=[],trips=[],logs=[],events=[],changes=[],rules=[],drivers=[],selectedDevice=null,loadToken=0,expandedEvents={};\nconst $=id=>document.getElementById(id);\nconst call=(api,t,s)=>new Promise((ok,err)=>api.call('Get',{typeName:t,search:s||{}},ok,err));\nconst esc=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\nfunction parseDurationMs(d){if(d==null||d===\"\")return 0;const str=String(d);const m=str.match(/^(?:(\\d+)\\.)?(\\d{1,2}):(\\d{2}):(\\d{2})(?:\\.\\d+)?$/);if(m){const days=Number(m[1]||0);return(days*86400+Number(m[2]||0)*3600+Number(m[3]||0)*60+Number(m[4]||0))*1000}const n=Number(d);return isNaN(n)?0:n}\nfunction fmtDate(d){try{return new Date(d).toLocaleString('pt-BR')}catch(e){return String(d||'')}}\nfunction fmtNum(n){return Number(n||0).toLocaleString('pt-BR')}\nfunction currentRange(){const fromEl=$('dateFrom'),toEl=$('dateTo');let from=fromEl&&fromEl.value?new Date(fromEl.value):null,to=toEl&&toEl.value?new Date(toEl.value):null;if(!from||isNaN(from.getTime())){const days=Number($('periodFilter').value)||1;to=to&&!isNaN(to.getTime())?to:new Date();from=new Date(to.getTime()-days*DAY_MS)}if(!to||isNaN(to.getTime()))to=new Date();if(from.getTime()>to.getTime()){const tmp=from;from=to;to=tmp}return{from,to}}\nfunction shell(){\n$('app').innerHTML=`<div class=\"head\"><div class=\"title\"><strong>Fleet Trip 360</strong><div class=\"sub\">Historico real de viagens - MyGeotab</div></div><div class=\"pill\" id=\"statusBox\">Conectando...</div></div>\n<div class=\"bar\">\n<input id=\"deviceQuery\" list=\"deviceList\" placeholder=\"Placa ou nome do veiculo\" style=\"min-width:260px\"/><datalist id=\"deviceList\"></datalist>\n<select id=\"periodFilter\"><option value=\"1\" selected>Hoje</option><option value=\"7\">7 dias</option><option value=\"custom\">Personalizado</option></select>\n<label class=\"datefield\">De <input type=\"datetime-local\" id=\"dateFrom\"/></label>\n<label class=\"datefield\">Ate <input type=\"datetime-local\" id=\"dateTo\"/></label>\n<button class=\"primary\" id=\"loadBtn\">Consultar</button>\n<button id=\"clearBtn\">Limpar</button>\n<button id=\"pdfBtn\">Exportar PDF</button>\n</div>\n<div class=\"info\"><span>Veiculos: <b id=\"countBox\">0</b></span><span>Viagens: <b id=\"tripCount\">0</b></span><span>Distancia: <b id=\"distanceKm\">0</b> km</span></div>\n<div id=\"alertBox\" class=\"alert\" style=\"display:none\"></div>\n<div id=\"kpisBox\" class=\"grid\"></div>\n<div class=\"cols\" style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px\">\n<div class=\"panel\"><div class=\"pt\">Mapa do historico</div><div id=\"mapBox\" class=\"map\"></div></div>\n<div class=\"panel\"><div class=\"pt\">Viagens</div><div id=\"tripsBox\"></div></div>\n</div>\n<div class=\"panel\"><div class=\"pt\">Excecoes agrupadas</div><div id=\"eventsBox\"></div></div>\n<footer class=\"project-credit\">Desenvolvido por Bruno Henrique Felisbino Goncalves</footer>`;\n$('app').addEventListener('click',function(event){const target=event.target.closest('[data-trip-group]');if(!target)return;const key=target.getAttribute('data-trip-group');expandedEvents[key]=!expandedEvents[key];render()});\n$('loadBtn').onclick=()=>loadHistory(apiRef);\n$('clearBtn').onclick=clearFilters;\n$('pdfBtn').onclick=()=>exportPdf();\n$('periodFilter').onchange=()=>{setRangeFromPeriod();};\nsetRangeFromPeriod();\n}\nfunction setRangeFromPeriod(){const days=Number($('periodFilter').value)||1;const to=new Date();const from=new Date(to.getTime()-days*DAY_MS);$('dateFrom').value=toLocalInput(from);$('dateTo').value=toLocalInput(to)}\nfunction toLocalInput(d){const pad=n=>String(n).padStart(2,'0');return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T'+pad(d.getHours())+':'+pad(d.getMinutes())}\nasync function loadDevices(){try{const devs=await call(apiRef,'Device',{});vehicles=devs||[];$('countBox').textContent=vehicles.length;const dl=$('deviceList');dl.innerHTML=vehicles.map(d=>`<option value=\"${esc(d.id)}\">${esc(d.name||d.id)} ${d.licensePlate?'- '+esc(d.licensePlate):''}</option>`).join('')}catch(e){console.error(e);alertMsg('Erro ao carregar veiculos: '+(e.message||''),false,true)}}\nasync function loadHistory(api){if(!api){alertMsg('Abra dentro do MyGeotab.',false,true);return}const q=($('deviceQuery').value||'').toLowerCase().trim();const found=vehicles.find(v=>((v.name||'')+' '+(v.licensePlate||'')).toLowerCase().includes(q)||v.id===q);const id=found?found.id:'';if(!id){alertMsg('Selecione um veiculo valido.',false,true);return}selectedDevice=vehicles.find(v=>v.id===id);const range=currentRange();const token=++loadToken;setStatus('Consultando viagens...');try{const [tr,lr,ee,dc,rl,dv]=await Promise.all([call(api,'Trip',{deviceSearch:{id:id},fromDate:range.from.toISOString(),toDate:range.to.toISOString(),includeOverlappedTrips:true}).catch(()=>[]),call(api,'LogRecord',{deviceSearch:{id:id},fromDate:range.from.toISOString(),toDate:range.to.toISOString()}).catch(()=>[]),call(api,'ExceptionEvent',{deviceSearch:{id:id},fromDate:range.from.toISOString(),toDate:range.to.toISOString(),includeExceptionCount:true}).catch(()=>[]),call(api,'DriverChange',{deviceSearch:{id:id},fromDate:range.from.toISOString(),toDate:range.to.toISOString(),includeOverlappedChanges:true}).catch(()=>[]),call(api,'Rule',{}).catch(()=>[]),call(api,'Driver',{}).catch(()=>[])]);if(token!==loadToken)return;trips=tr||[];changes=dc||[];rules=rl||[];drivers=dv||[];logs=(lr||[]).sort((a,b)=>new Date(a.dateTime)-new Date(b.dateTime));events=ee||[];render();setStatus(trips.length+' viagens carregadas');alertMsg('Consulta concluida.',true)}catch(e){console.error(e);setStatus('Erro');alertMsg('Erro: '+(e.message||''),false,true)}}\nfunction ruleName(id){const r=rules.find(x=>x.id===id);return r&&r.name?r.name:'Regra'}\nfunction driverName(id){const d=drivers.find(x=>x.id===id);return d&&d.name?d.name:id}\nfunction render(){renderKpis();renderTrips();renderEvents();renderMap()}\nfunction renderKpis(){const official=trips.reduce((s,t)=>s+Number(t.distance||t.Distance||0),0);let dist=official;if(!dist&&logs.length>1){let km=0;for(let i=1;i<logs.length;i++){const a=logs[i-1],b=logs[i];const R=6371,dLat=(Number(b.latitude)-Number(a.latitude))*Math.PI/180,dLng=(Number(b.longitude)-Number(a.longitude))*Math.PI/180;const x=Math.sin(dLat/2)**2+Math.cos(Number(a.latitude)*Math.PI/180)*Math.cos(Number(b.latitude)*Math.PI/180)*Math.sin(dLng/2)**2;km+=R*2*Math.atan2(Math.sqrt(x),Math.sqrt